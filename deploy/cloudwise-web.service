[Unit]
Description=CloudWise AI Streamlit
After=network.target cloudwise-api.service

[Service]
Type=simple
User=__USER__
WorkingDirectory=__APP_ROOT__
Environment=MPLBACKEND=Agg
ExecStart=__APP_ROOT__/.venv/bin/streamlit run app.py --server.address 127.0.0.1 --server.port 8501 --server.headless true --browser.gatherUsageStats false
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
