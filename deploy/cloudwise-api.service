[Unit]
Description=CloudWise AI FastAPI
After=network.target

[Service]
Type=simple
User=__USER__
WorkingDirectory=__APP_ROOT__
Environment=MPLBACKEND=Agg
ExecStart=__APP_ROOT__/.venv/bin/uvicorn backend:app --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
